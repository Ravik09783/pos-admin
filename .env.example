# =============================================================================
# RestoPOS env vars
#
# Copy this file to `.env.local` for local dev. In production set these in your
# hosting platform's dashboard (Vercel / Cloudflare Pages / etc.).
#
# Variables prefixed with NEXT_PUBLIC_ are sent to the browser. Everything else
# stays server-only. NEVER put a service_role / secret key behind a
# NEXT_PUBLIC_ name.
# =============================================================================


# ── Supabase  (REQUIRED) ─────────────────────────────────────────────────────
# Find these in Supabase Studio → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Service-role key — bypasses RLS. Used by server-side admin routes
# (creating staff, webhook handlers). NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ── App URL  (REQUIRED) ──────────────────────────────────────────────────────
# Canonical public URL. Used for payment redirect URLs, the verified-bill
# link, the QR ordering URL, invite links. Must match Supabase Auth → URL
# Configuration → Site URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Stripe (US / EU / global card payments) — platform-wide ────────────────
# RestoPOS is the Stripe merchant; each restaurant is a Connect
# "connected account" that receives transfers.
# Stripe deducts its processing fee from the gross, then the platform's
# `application_fee_amount` (1% by default), and routes the rest to the
# restaurant's Stripe-connected bank account.
#
# Setup:
#   1. Stripe Dashboard → Developers → API Keys → copy BOTH keys:
#        - Secret key (sk_…)         → STRIPE_SECRET_KEY  (server-side)
#        - Publishable key (pk_…)    → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#                                       (client-side — needed for the
#                                        embedded Connect dashboard)
#   2. Stripe Dashboard → Connect → enable + complete platform onboarding
#   3. Stripe Dashboard → Developers → Webhooks → Add endpoint:
#        URL: <APP_URL>/api/webhooks/stripe
#        Events to subscribe to:
#          ── Customer-bill payments via Connect (restaurant ← customer) ──
#            payment_intent.succeeded
#            payment_intent.payment_failed
#            checkout.session.completed
#            charge.refunded
#            charge.dispute.created       ← chargeback alert
#            charge.dispute.closed
#          ── Connect account lifecycle ────────────────────────────────────
#            account.updated              ← KYC progress
#            account.application.deauthorized   ← restaurant disconnected
#            payout.paid                  ← bank payout summary
#            payout.failed
#          ── Platform SaaS subscription (platform → restaurant) ──────────
#            customer.subscription.created
#            customer.subscription.updated
#            customer.subscription.deleted
#            customer.subscription.trial_will_end   ← 3-day reminder
#            invoice.payment_succeeded
#            invoice.payment_failed
#            invoice.upcoming             ← 7-day pre-bill reminder
#      → copy the signing secret
#
#   The webhook handler is idempotent — every event id is recorded
#   in `stripe_webhook_events` so Stripe redeliveries don't double-
#   process. Safe to "Send test webhook" repeatedly during setup.
#   4. Restaurants self-onboard from Settings → Payments via the
#      "Connect with Stripe" button (Stripe Connect Express). The
#      resulting acct_* is written back automatically — no manual steps.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform commission on Stripe transactions, percent of gross. Default 1%.
# Stripe's own processing fee is deducted by Stripe BEFORE this, so the
# restaurant receives: gross − stripe_fee − application_fee.
STRIPE_PLATFORM_FEE_PERCENT=1

# ── Paytm (India UPI scan-to-pay) ────────────────────────────────────────────
# OPTIONAL platform-level fallback. The real model is per-tenant: each
# restaurant connects its own Paytm in Settings → Payment Gateway, and the
# credentials are stored on `tenant_payment_gateways`. These env vars are
# used ONLY when a tenant has not connected its own Paytm — convenient for
# single-restaurant dev/testing. See docs/paytm-setup.md.
#   PAYTM_ENV: 'staging' (test, securegw-stage) or 'production' (live).
PAYTM_ENV=staging
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID_WEB=WEB
PAYTM_CHANNEL_ID_WAP=WAP

# ── SEO — search-engine site verification (optional) ────────────────────────
# Paste the verification token from each tool's "HTML tag" method. They
# render as <meta> tags on every page; leave blank to skip.
#   Google Search Console → https://search.google.com/search-console
#   Bing Webmaster Tools  → https://www.bing.com/webmasters
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Scheduled-job secret ────────────────────────────────────────────────────
# Protects cron-only endpoints — currently the Paytm reconciliation sweep
# (/api/payments/paytm/reconcile), the missed-webhook safety net. Set this
# to a long random string. Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`; any other scheduler must send the
# same header. If unset, the reconcile endpoint refuses to run.
CRON_SECRET=

# ── Platform SaaS subscription tiers ────────────────────────────────────────
# RestoPOS charges restaurants a recurring monthly fee scaled by outlet
# count and staff seats. Three tiers per region:
#
#   Tier      INR (India)   USD (Other countries)   Outlets   Staff/outlet
#   Starter   ₹3,500/mo      $49/mo                  1         1
#   Growth    ₹5,000/mo      $99/mo                  3         3
#   Scale     ₹10,000/mo     $199/mo                 10        3
#
# Setup:
#   1. Stripe Dashboard (PLATFORM account, not a Connect account) →
#      Products → New → recurring monthly price. Repeat for every tier
#      you want to offer in every currency. Copy each price_* id.
#   2. Paste the price ids below. Leave any tier blank if you don't want
#      to offer it yet — the UI hides empty tiers.
#   3. Stripe Dashboard → Settings → Customer Portal → enable + configure
#      self-serve (update card, view invoices, cancel). /api/billing/portal
#      hands customers a portal session url.
#   4. Add these to the webhook endpoint's events list:
#        customer.subscription.created
#        customer.subscription.updated
#        customer.subscription.deleted
#        invoice.payment_succeeded
#        invoice.payment_failed
#
# India tier price ids (INR recurring prices on the platform Stripe acct):
STRIPE_PLATFORM_PRICE_ID_IN_STARTER=
STRIPE_PLATFORM_PRICE_ID_IN_GROWTH=
STRIPE_PLATFORM_PRICE_ID_IN_SCALE=
# Non-India tier price ids (USD recurring prices on the platform Stripe acct):
STRIPE_PLATFORM_PRICE_ID_INTL_STARTER=
STRIPE_PLATFORM_PRICE_ID_INTL_GROWTH=
STRIPE_PLATFORM_PRICE_ID_INTL_SCALE=
# Legacy single-price env (kept so existing deploys don't break). New
# deploys can leave this blank and set the per-tier vars above instead.
STRIPE_PLATFORM_PRICE_ID=


# ── Google Pay configuration — optional for POS QR payments
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_NAME=Test Merchant
GOOGLE_PAY_MERCHANT_ID=BCR2DN4T2MTEST


# ── Web Push notifications — strongly recommended for QR ordering ──────────
# Browser → OS-level push notifications when a QR order is paid. Works
# even when the dashboard tab is closed, browser is closed, or device
# is locked. Free — uses each browser's built-in push service (FCM /
# Mozilla Autopush / APNs).
#
# Generate the keypair ONCE (any of the three methods works):
#   npx web-push generate-vapid-keys
#   OR:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#   OR online: https://vapidkeys.com  (only for testing — generate yours)
#
# VAPID_SUBJECT is a contact URL or mailto: that push services can use
# to reach you if your traffic is abusive. Use your support email.
#
# The PUBLIC key is sent to the browser (NEXT_PUBLIC_) and used to
# verify push messages came from your server. The PRIVATE key signs
# every push from the server — NEVER expose it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.com


# ── Notifications (SMS / WhatsApp / Email) — optional ───────────────────────
# The notification routes are provider-agnostic; fill in whichever block you
# actually use. RESEND for transactional email, TWILIO for SMS / WhatsApp.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# ── Rate limiting (Upstash Redis) — optional ────────────────────────────────
# Used by the public QR ordering APIs. Without it, the in-memory fallback
# works fine for single-instance deploys; for multi-instance you NEED these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Error tracking — optional but strongly recommended for production ───────
# Wire one of: Sentry, Logtail, Better Stack, Datadog. The hook is in
# src/lib/errors.ts → `logError()`. If empty, errors only go to stdout.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=


# ── Health check token — optional ────────────────────────────────────────────
# If set, /api/health requires `Authorization: Bearer <token>` to expose
# detailed DB-ping info. Empty = open (basic 200/503 still works without it).
HEALTH_CHECK_TOKEN=


# ── Super-admin console — required to enable /super-admin ──────────────────
# Comma-separated list of email addresses that get access to the
# super-admin console at /super-admin. These are accounts that can:
#   - View every registered restaurant
#   - Impersonate any restaurant's OWNER (opens a magic-link login in a
#     new tab; the super-admin's own session stays intact)
#   - Permanently DELETE a restaurant — cascades through every DB table,
#     every uploaded storage blob, every staff auth login, and cancels
#     the Stripe subscription. There is no undo.
#
# The list is enforced both in the route gate (`src/app/super-admin/layout.tsx`)
# AND in every API endpoint under `/api/super-admin/*`. The /super-admin
# URL 404s for everyone whose email isn't in this list — including
# regular tenant OWNERs.
#
# Leave blank to disable the console entirely (any visit 404s).
RESTOPOS_SUPER_ADMIN_EMAILS=


# ── Plan enforcement override — optional ───────────────────────────────────
# Plan / tier limits (outlets per tenant, staff seats per outlet) come from
# `src/lib/billing/plans.ts` and are mirrored to tenants.plan_max_branches +
# tenants.plan_max_staff_per_br on plan switch. The SQL gate
# `is_user_within_plan_limits()` blocks logins of non-OWNER staff whose
# branch or seat sits past the cap.
#
# Set this to "unlimited" to disable plan enforcement GLOBALLY — useful for
# self-hosted deployments where you want all-you-can-eat, dev / staging
# environments where you don't want to wire Stripe price ids, or one-time
# emergency relief while debugging an enforcement bug in production.
#
# Leave blank (or anything other than "unlimited") to enforce as configured.
RESTOPOS_PLAN_OVERRIDE=
